import "../src/lib" as gui

let changed = fn(event) -> event.value
let clicked = fn(event) -> event.id

let input = gui.text_input("title", "Title")
assert(input.value == "", "text input must apply its default value")
assert(input.on_change == nil, "text input callback must be optional")

let area = gui.multiline("notes", "Notes", "hello", changed)
assert(area.value == "hello", "multiline initial value must be preserved")
assert(type_of(area.on_change) == "lambda", "multiline callback must be preserved")

let check = gui.checkbox("done", "Done")
assert(check.value == false, "checkbox must default to unchecked")

let range = gui.slider("priority", "Priority", 3, 1, 5, changed)
assert(range.min == 1 and range.max == 5, "slider bounds must be preserved")
assert(type_of(range.on_change) == "lambda", "slider callback must be preserved")

let button = gui.button("save", "Save", true, clicked)
assert(button.close == true, "button close behavior must be preserved")
assert(type_of(button.on_click) == "lambda", "button callback must be preserved")

let layout = gui.group("Mixer", [
    gui.row([gui.number_input("bpm", "BPM", 120), gui.select("wave", "Wave", ["sine", "square"], "sine")]),
    gui.grid(2, [gui.toggle("a", "A"), gui.toggle("b", "B")])
])
assert(layout.kind == "group", "group constructor")
assert(layout.children[0].kind == "row", "nested row constructor")
assert(layout.children[1].columns == 2, "grid columns")
assert(gui.value_text("status", "Status: ").kind == "value_text", "bound text constructor")
assert(gui.meter("level", "Level").kind == "meter", "bound meter constructor")

let document = gui.document("Studio", [layout], 900, 640, {bpm: 120}, "midnight")
assert(document.title == "Studio", "document title")
assert(document.width == 900 and document.height == 640, "document dimensions")
assert(document.state.bpm == 120, "document initial state")
assert(document.theme == "midnight", "document theme")
assert(len(gui.THEMES) == 4, "published theme list")
assert(len(gui.COMPONENTS) == 28, "Designer component catalog")
assert(gui.COMPONENTS[5].defaults.text == "Button", "component defaults live in Ject")
assert(len(gui.components()) == 28, "component catalog is available to facade functions")
assert(len(gui.TEMPLATES) == 2, "Designer starter templates")
assert(gui.TEMPLATES[0].document.widgets[2].kind == "card", "form template is a JGUI document")

assert(gui.code("x").kind == "code", "code constructor")
assert(gui.link("site", "https://example.com").url == "https://example.com", "link constructor")
assert(gui.badge("new").kind == "badge", "badge constructor")
assert(gui.wrap([]).kind == "wrap", "wrapping layout constructor")
assert(gui.card([]).kind == "card", "card constructor")
assert(gui.collapsible("More", []).open == true, "collapsible constructor")
assert(gui.password("secret", "Password").kind == "password", "password constructor")
assert(gui.radio("mode", "Mode", ["a", "b"], "a").value == "a", "radio constructor")

let decorated = gui.visible(gui.enabled(gui.with_tooltip(gui.button("go", "Go"), "Continue"), false), true)
assert(decorated.tooltip == "Continue", "tooltip modifier")
assert(decorated.enabled == false and decorated.visible == true, "visibility modifiers")
