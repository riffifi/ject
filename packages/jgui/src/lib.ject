# JGUI's public API is ordinary Ject. Rust receives a declarative document only.
import "@native/jgui" as native

export THEMES = native.themes()

# The Designer reads this catalog; adding a native widget does not require a second
# palette or default-value table in Rust.
fn component_catalog()
    return [
    {kind: "heading", category: "Text", defaults: {text: "Heading"}},
    {kind: "label", category: "Text", defaults: {text: "Label"}},
    {kind: "code", category: "Text", defaults: {text: "let answer = 42"}},
    {kind: "link", category: "Text", defaults: {text: "Open link", url: "https://example.com"}},
    {kind: "badge", category: "Text", defaults: {text: "New"}},
    {kind: "button", category: "Controls", defaults: {id: "", text: "Button", close: false}},
    {kind: "text_input", category: "Controls", defaults: {id: "", label: "Label", value: ""}},
    {kind: "password", category: "Controls", defaults: {id: "", label: "Password", value: ""}},
    {kind: "multiline", category: "Controls", defaults: {id: "", label: "Label", value: ""}},
    {kind: "checkbox", category: "Controls", defaults: {id: "", text: "Label", value: false}},
    {kind: "slider", category: "Controls", defaults: {id: "", text: "Value", value: 0, min: 0, max: 100}},
    {kind: "number_input", category: "Controls", defaults: {id: "", text: "Value", value: 0, speed: 1}},
    {kind: "select", category: "Controls", defaults: {id: "", text: "Choice", options: ["First", "Second"], value: "First"}},
    {kind: "radio", category: "Controls", defaults: {id: "", text: "Choice", options: ["First", "Second"], value: "First"}},
    {kind: "toggle", category: "Controls", defaults: {id: "", text: "Label", value: false}},
    {kind: "progress", category: "Data", defaults: {text: "Progress", value: 0.5}},
    {kind: "meter", category: "Data", defaults: {id: "", text: "Level", value: 0.5}},
    {kind: "value_text", category: "Data", defaults: {id: "", text: "Value: ", value: "Preview"}},
    {kind: "spacer", category: "Layout", defaults: {value: 8}},
    {kind: "row", category: "Layout", defaults: {children: []}},
    {kind: "wrap", category: "Layout", defaults: {children: []}},
    {kind: "column", category: "Layout", defaults: {children: []}},
    {kind: "group", category: "Layout", defaults: {text: "Group", children: []}},
    {kind: "card", category: "Layout", defaults: {children: []}},
    {kind: "collapsible", category: "Layout", defaults: {text: "Section", open: true, children: []}},
    {kind: "grid", category: "Layout", defaults: {columns: 2, spacing: 8, children: []}},
    {kind: "scroll", category: "Layout", defaults: {height: 300, children: []}},
    {kind: "separator", category: "Layout", defaults: {}}
    ]
end

export COMPONENTS = component_catalog()

export fn components()
    return component_catalog()
end

fn designer_templates()
    return [
        {name: "Form", document: {
            title: "New form", width: 640, height: 520, theme: "linen", state: {},
            widgets: [
                {kind: "heading", text: "Create account"},
                {kind: "label", text: "Enter the details below."},
                {kind: "card", children: [
                    {kind: "column", children: [
                        {kind: "text_input", id: "name", label: "Name", value: ""},
                        {kind: "text_input", id: "email", label: "Email", value: ""},
                        {kind: "password", id: "password", label: "Password", value: ""},
                        {kind: "checkbox", id: "updates", text: "Send me product updates", value: true}
                    ]}
                ]},
                {kind: "row", children: [
                    {kind: "button", id: "create", text: "Create account", close: true},
                    {kind: "button", id: "cancel", text: "Cancel", close: true}
                ]}
            ]
        }},
        {name: "Dashboard", document: {
            title: "Dashboard", width: 900, height: 620, theme: "midnight", state: {},
            widgets: [
                {kind: "row", children: [
                    {kind: "heading", text: "Overview"},
                    {kind: "badge", text: "Live"}
                ]},
                {kind: "grid", columns: 3, spacing: 12, children: [
                    {kind: "card", children: [{kind: "label", text: "Revenue"}, {kind: "value_text", id: "revenue", text: "$", value: "24,850"}]},
                    {kind: "card", children: [{kind: "label", text: "Projects"}, {kind: "value_text", id: "projects", value: 12}]},
                    {kind: "card", children: [{kind: "label", text: "Capacity"}, {kind: "meter", id: "capacity", text: "68%", value: 0.68}]}
                ]},
                {kind: "collapsible", text: "Filters", open: true, children: [
                    {kind: "wrap", children: [
                        {kind: "select", id: "period", text: "Period", options: ["Week", "Month", "Year"], value: "Month"},
                        {kind: "toggle", id: "archived", text: "Include archived", value: false}
                    ]}
                ]}
            ]
        }}
    ]
end

export TEMPLATES = designer_templates()

export fn heading(text)
    return {kind: "heading", text: text}
end

export fn label(text)
    return {kind: "label", text: text}
end

export fn code(text)
    return {kind: "code", text: text}
end

export fn link(text, url)
    return {kind: "link", text: text, url: url}
end

export fn badge(text)
    return {kind: "badge", text: text}
end

export fn separator()
    return {kind: "separator"}
end

export fn row(children)
    return {kind: "row", children: children}
end

export fn wrap(children)
    return {kind: "wrap", children: children}
end

export fn column(children)
    return {kind: "column", children: children}
end

export fn group(title, children)
    return {kind: "group", text: title, children: children}
end

export fn card(children)
    return {kind: "card", children: children}
end

export fn collapsible(title, children, open = true)
    return {kind: "collapsible", text: title, children: children, open: open}
end

export fn scroll(children, height = 300)
    return {kind: "scroll", children: children, height: height}
end

export fn grid(columns, children, spacing = 8)
    return {kind: "grid", columns: columns, children: children, spacing: spacing}
end

export fn text_input(id, label_text, initial = "", on_change = nil)
    return {kind: "text_input", id: id, label: label_text, value: initial, on_change: on_change}
end

export fn password(id, label_text, initial = "", on_change = nil)
    return {kind: "password", id: id, label: label_text, value: initial, on_change: on_change}
end

export fn multiline(id, label_text, initial = "", on_change = nil)
    return {kind: "multiline", id: id, label: label_text, value: initial, on_change: on_change}
end

export fn checkbox(id, text, checked = false, on_change = nil)
    return {kind: "checkbox", id: id, text: text, value: checked, on_change: on_change}
end

export fn slider(id, text, value = 0, minimum = 0, maximum = 100, on_change = nil)
    return {kind: "slider", id: id, text: text, value: value, min: minimum, max: maximum, on_change: on_change}
end

export fn number_input(id, text, value = 0, speed = 1, on_change = nil)
    return {kind: "number_input", id: id, text: text, value: value, speed: speed, on_change: on_change}
end

export fn select(id, text, options, selected = "", on_change = nil)
    return {kind: "select", id: id, text: text, options: options, value: selected, on_change: on_change}
end

export fn radio(id, text, options, selected = "", on_change = nil)
    return {kind: "radio", id: id, text: text, options: options, value: selected, on_change: on_change}
end

export fn toggle(id, text, active = false, on_change = nil)
    return {kind: "toggle", id: id, text: text, value: active, on_change: on_change}
end

export fn progress(value, text = "")
    return {kind: "progress", value: value, text: text}
end

export fn meter(id, text = "", value = 0)
    return {kind: "meter", id: id, text: text, value: value}
end

export fn value_text(id, text = "", fallback = nil)
    return {kind: "value_text", id: id, text: text, value: fallback}
end

export fn button(id, text, closes_window = false, on_click = nil)
    return {kind: "button", id: id, text: text, close: closes_window, on_click: on_click}
end

export fn spacer(points = 8)
    return {kind: "spacer", value: points}
end

export fn with_tooltip(widget, text)
    widget.tooltip = text
    return widget
end

export fn enabled(widget, condition)
    widget.enabled = condition
    return widget
end

export fn visible(widget, condition)
    widget.visible = condition
    return widget
end

export fn document(title, widgets, width = 680, height = 560, state = {}, theme = "linen")
    assert(type_of(title) == "string", "window title must be a string")
    assert(type_of(widgets) == "array", "widgets must be an array")
    assert(width > 0 and height > 0, "window dimensions must be positive")
    assert(theme == "linen" or theme == "midnight" or theme == "egui-light" or theme == "egui-dark", "unknown JGUI theme")
    return {title: title, width: width, height: height, widgets: widgets, state: state, theme: theme}
end

export fn run(title, widgets, width = 680, height = 560, state = {}, theme = "linen")
    return show(document(title, widgets, width, height, state, theme))
end

export fn designer(path = "interface.json")
    return native.designer(path, component_catalog(), designer_templates())
end

export fn show(document)
    assert(type_of(document) == "dictionary", "show expects a JGUI document")
    return native.run(document)
end

export fn message(title, text)
    return run(title, [heading(title), label(text), spacer(), button("ok", "OK", true)], 440, 220)
end

export fn confirm(title, question)
    return run(title, [heading(title), label(question), separator(), button("yes", "Yes", true), button("no", "No", true)], 460, 240)
end
