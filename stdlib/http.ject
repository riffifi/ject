# Blocking HTTP client. Rust provides transport; this file defines the public API.

export fn request(method, url, headers={}, body=nil, timeout_ms=30000, max_response_bytes=16777216)
    return _request(method, url, headers, body, timeout_ms, max_response_bytes)
end

export fn get(url, headers={}, timeout_ms=30000, max_response_bytes=16777216)
    return request("GET", url, headers, nil, timeout_ms, max_response_bytes)
end

export fn post(url, body, headers={}, timeout_ms=30000, max_response_bytes=16777216)
    return request("POST", url, headers, body, timeout_ms, max_response_bytes)
end
