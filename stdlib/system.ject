# System Standard Library Module
# Process and directory primitives are provided by the host.

export fn args()
    return _args()
end

export fn env(name) return _env(name) end
export fn exit(code=0) return _exit(code) end
export fn input(prompt="") return _input(prompt) end
export fn exec(command) return _exec(command) end
export fn cwd() return _cwd() end
export fn file_exists(path) return _file_exists(path) end
export fn is_file(path) return _is_file(path) end
export fn is_dir(path) return _is_dir(path) end
export fn now() return _now() end
export fn timestamp() return _timestamp() end
export fn sleep(milliseconds) return _sleep(milliseconds) end

export fn get_cwd()
    return cwd()
end

export fn change_dir(path)
    return _change_dir(path)
end

export fn run_process(program, arguments=[], directory=nil, timeout_ms=nil, max_output_bytes=16777216)
    return _run_process(program, arguments, directory, timeout_ms, max_output_bytes)
end
