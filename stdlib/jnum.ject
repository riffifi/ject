end

# Random
export fn random()
    return jn.random()
end

export fn rand()
    return jn.rand()
end

export fn randint(low, high, size)
    if size == nil then
        return jn.randint(low, high, 1)
    else
        return jn.randint(low, high, size)
    end
end

# Constants
export PI = jn.PI
export E = jn.E
export INF = jn.inf
export NAN = jn.nan
