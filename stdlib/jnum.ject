end

export fn exp(arr)
    return jn.exp(arr)
end

export fn log(arr)
    return jn.log(arr)
end

export fn log10(arr)
    return jn.log10(arr)
end

export fn abs(arr)
    return jn.abs(arr)
end

export fn ceil(arr)
    return jn.ceil(arr)
end

export fn floor(arr)
    return jn.floor(arr)
end

export fn round(arr)
    return jn.round(arr)
end

export fn clip(arr, min_val, max_val)
    return jn.clip(arr, min_val, max_val)
end

