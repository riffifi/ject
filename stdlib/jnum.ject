# Advanced Math Module for Ject
# High-performance numerical computing with Rust backend
# 
# Usage:
#   import "jnum"
#   let arr = jn.array([1, 2, 3, 4, 5])
#   print jn.sum(arr)

# Re-export all jnum functions with shorter names
import "@native/jnum" as jn

# Convenience wrappers for common operations
export fn array(data)
    return jn.array(data)
end

export fn zeros(n)
    return jn.zeros(n)
end

export fn ones(n)
    return jn.ones(n)
end

export fn arange(start, stop, step)
    if step == nil then
        if stop == nil then
            return jn.arange(0, start, 1)
        else
            return jn.arange(0, stop, 1)
        end
    else
        return jn.arange(start, stop, step)
    end
end

export fn linspace(start, stop, num)
    if num == nil then
        return jn.linspace(start, stop, 50)
    else
        return jn.linspace(start, stop, num)
    end
end

export fn eye(n, m)
    if m == nil then
        return jn.eye(n)
    else
        return jn.eye(n, m)
    end
end

export fn identity(n)
    return jn.identity(n)
end

# Properties
export fn shape(arr)
    return jn.shape(arr)
end

export fn ndim(arr)
    return jn.ndim(arr)
end

export fn size(arr)
    return jn.size(arr)
end

# Manipulation
export fn reshape(arr, new_shape)
    return jn.reshape(arr, new_shape)
end

export fn flatten(arr)
    return jn.flatten(arr)
end

export fn transpose(arr)
    return jn.transpose(arr)
end

export fn concatenate(arrays)
    return jn.concatenate(arrays)
end

export fn stack(arrays)
    return jn.stack(arrays)
end

