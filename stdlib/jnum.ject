    return jn.sum(arr)
end

export fn mean(arr)
    return jn.mean(arr)
end

export fn std(arr)
    return jn.std(arr)
end

export fn var(arr)
    return jn.var(arr)
end

export fn min(arr)
    return jn.min(arr)
end

export fn max(arr)
    return jn.max(arr)
end

export fn argmin(arr)
    return jn.argmin(arr)
end

export fn argmax(arr)
    return jn.argmax(arr)
end

export fn cumsum(arr)
    return jn.cumsum(arr)
end

export fn any(arr)
    return jn.any(arr)
end

export fn all(arr)
