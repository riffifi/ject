# color.ject - ANSI terminal color and style helpers.
#
# Each function wraps text in an ANSI escape code and resets styling afterward,
# so calls can be nested/concatenated freely:
#
#   import "color" as c
#   print(c.bold(c.green("Build succeeded")))
#   print(c.red("Error: ") + "file not found")


let RESET = "\u001b[0m"

fn wrap(code, text)
    return code + text + RESET
end

#  Foreground colors 

export fn black(text)
    return wrap("\u001b[30m", text)
end

export fn red(text)
    return wrap("\u001b[31m", text)
end

export fn green(text)
    return wrap("\u001b[32m", text)
end

export fn yellow(text)
    return wrap("\u001b[33m", text)
end

export fn blue(text)
    return wrap("\u001b[34m", text)
end

export fn magenta(text)
    return wrap("\u001b[35m", text)
end

export fn cyan(text)
    return wrap("\u001b[36m", text)
end

export fn white(text)
    return wrap("\u001b[37m", text)
end

export fn gray(text)
    return wrap("\u001b[90m", text)
end

#  Background colors 

export fn bg_red(text)
    return wrap("\u001b[41m", text)
end

export fn bg_green(text)
    return wrap("\u001b[42m", text)
end

export fn bg_yellow(text)
    return wrap("\u001b[43m", text)
end

export fn bg_blue(text)
    return wrap("\u001b[44m", text)
end

#  Styles 

export fn bold(text)
    return wrap("\u001b[1m", text)
end

export fn dim(text)
    return wrap("\u001b[2m", text)
end

export fn underline(text)
    return wrap("\u001b[4m", text)
end

export fn italic(text)
    return wrap("\u001b[3m", text)
end

export fn rgb(text, r, g, b)
    return wrap("\u001b[38;2;" + r + ";" + g + ";" + b + "m", text)
end

export fn bg_rgb(text, r, g, b)
    return wrap("\u001b[48;2;" + r + ";" + g + ";" + b + "m", text)
end

export fn success(text)
    return green(text)
end

export fn error(text)
    return red(text)
end

export fn warning(text)
    return yellow(text)
end

export fn info(text)
    return cyan(text)
end
