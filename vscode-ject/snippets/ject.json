{
  "Print": {
    "prefix": "print",
    "body": "print ${1:value}",
    "description": "Print a value"
  },
  "Let Binding": {
    "prefix": "let",
    "body": "let ${1:name} = ${2:value}",
    "description": "Declare a variable"
  },
  "Function": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:params})",
      "    ${0}",
      "end"
    ],
    "description": "Define a function"
  },
  "Lambda": {
    "prefix": "lambda",
    "body": "lambda(${1:x}) -> ${2:x}",
    "description": "Create a lambda expression"
  },
  "If": {
    "prefix": "if",
    "body": [
      "if ${1:condition}",
      "    ${0}",
      "end"
    ],
    "description": "If statement"
  },
  "If Else": {
    "prefix": "ife",
    "body": [
      "if ${1:condition}",
      "    ${2}",
      "else",
      "    ${0}",
      "end"
    ],
    "description": "If/else statement"
  },
  "For Loop": {
    "prefix": "for",
    "body": [
      "for ${1:item} in ${2:items} do",
      "    ${0}",
      "end"
    ],
    "description": "For loop"
  },
  "While Loop": {
    "prefix": "while",
    "body": [
      "while ${1:condition} do",
      "    ${0}",
      "end"
    ],
    "description": "While loop"
  },
  "Try Catch": {
    "prefix": "try",
    "body": [
      "try",
      "    ${1}",
      "catch ${2:err}",
      "    ${0}",
      "end"
    ],
    "description": "Try/catch block"
  },
  "Struct": {
    "prefix": "struct",
    "body": "struct ${1:Name} {${2:field}}",
    "description": "Define a struct"
  },
  "Import Module": {
    "prefix": "import",
    "body": "import \"${1:module}\"",
    "description": "Import a module"
  },
  "Selective Import": {
    "prefix": "from",
    "body": "import {${1:item}} from \"${2:module}\"",
    "description": "Import selected symbols"
  },
  "Export Function": {
    "prefix": "exportfn",
    "body": [
      "export fn ${1:name}(${2:params})",
      "    ${0}",
      "end"
    ],
    "description": "Export a function"
  },
  "Unique Array": {
    "prefix": "uarray",
    "body": "{|${1:items}|}",
    "description": "Unique array literal"
  },
  "Named Slice": {
    "prefix": "slice",
    "body": "${1:arr}[from:${2:0} to:${3:end} step:${4:1}]",
    "description": "Named slice syntax"
  },
  "Interpolation": {
    "prefix": "interp",
    "body": "\"${1:text} \\${${2:expr}}\"",
    "description": "String interpolation"
  }
}
