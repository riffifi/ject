print "Launching Ject JGUI demo..."

import {window, label, separator, button, input, run} from "jgui"

let app = window("Ject JGUI Demo", 560, 380)

label(app, "Welcome to Ject JGUI")
label(app, "Fill the fields and click buttons, then close the window.")
separator(app)

input(app, "name", "Name:", "")
input(app, "email", "Email:", "")
separator(app)

button(app, "save", "Save")
button(app, "cancel", "Cancel")

let result = run(app)

print "JGUI closed."
print "Buttons:"
print result["buttons"]
print "Inputs:"
print result["inputs"]