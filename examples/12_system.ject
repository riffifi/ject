import "system" as system

print "Current directory: " + system.get_cwd()
print "HOME: " + system.env("HOME")

# run_process passes each argument literally and reports both output streams.
let result = system.run_process("git", ["--version"])
if result.success then
    print result.stdout.trim()
else
    print "git exited with status " + result.status
    print result.stderr
end
