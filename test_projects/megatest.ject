print "=== Ject Mega Test: start ==="

# ------------------------------------------------------------
# 1) Core types, conversion, and truthiness-ish checks
# ------------------------------------------------------------
assert(type_of(1) == "number", "int type")
assert(type_of(1.5) == "number", "float type")
assert(type_of("x") == "string", "string type")
assert(type_of(true) == "boolean", "bool type")
assert(type_of(nil) == "nil", "nil type")
assert(type_of([1, 2]) == "array", "array type")
assert(type_of({a: 1}) == "dictionary", "dictionary type")

assert(to_int("42") == 42, "to_int")
assert(to_float("3.5") == 3.5, "to_float")
assert(to_string(99) == "99", "to_string")
assert(to_bool(0) == false, "to_bool(0)")
assert(to_bool(1) == true, "to_bool(1)")

# ------------------------------------------------------------
# 2) Arrays, indexing, slicing, multiline literals, unique arrays
# ------------------------------------------------------------
let arr = [
    0,
    1,
    2,
    3,
    4,
    5,
]

assert(arr[0] == 0, "array index 0")
assert(arr[-1] == 5, "array negative index")
assert(arr[1:4] == [1, 2, 3], "python style slice")
assert(arr[::2] == [0, 2, 4], "python style step slice")
assert(arr[1..5:2] == [1, 3], "range style slice")
assert(arr[from:1 to:5 step:2] == [1, 3], "named slice")

let rev = arr[::-1]
assert(rev == [5, 4, 3, 2, 1, 0], "reverse slice")

let matrix = [[1, 2], [3, 4], [5, 6]]
assert(matrix[0][1] == 2, "nested index access")

let uniq = {|"a", "b", "a", "b", "c"|}
assert(type_of(uniq) == "unique_array", "unique array type")

# ------------------------------------------------------------
# 3) Dictionaries, key helpers, assignment semantics
# ------------------------------------------------------------
let person = {
    name: "Alice",
    age: 30,
}

assert(person.name == "Alice", "dict dot access")
assert(person["age"] == 30, "dict bracket access")

person.age = 31
assert(person.age == 31, "dict field assignment")

person["city"] = "Cairo"
assert(person.city == "Cairo", "dict bracket assignment")

assert(has_key(person, "name") == true, "has_key true")
assert(has_key(person, "missing") == false, "has_key false")

let person2 = delete(person, "city")
assert(has_key(person2, "city") == false, "delete key")
assert(len(keys(person2)) == 2, "keys length")
assert(len(values(person2)) == 2, "values length")

# ------------------------------------------------------------
# 4) Operators: compound, inc/dec, comparisons, logic
# ------------------------------------------------------------
let x = 10
x += 5
x -= 3
x *= 2
x /= 4
assert(x == 6, "compound operators chain")

let c = 1
let post = c++
assert(post == 1, "post increment returns old")
assert(c == 2, "post increment updates")
let pre = ++c
assert(pre == 3, "pre increment returns new")
assert(c == 3, "pre increment updates")

let d = 3
let post_dec = d--
assert(post_dec == 3 and d == 2, "post decrement")
let pre_dec = --d
assert(pre_dec == 1 and d == 1, "pre decrement")

assert((2 < 3) and (3 <= 3) and (3 >= 3) and (4 > 3), "comparison ops")
assert((1 in [1, 2, 3]) == true, "in array")
assert(("ell" in "hello") == true, "in string")
assert(("name" in person2) == true, "in dictionary keys")

# ------------------------------------------------------------
# 5) Control flow, inline conditional expression, break/continue
# ------------------------------------------------------------
let sign = if -3 > 0 then "pos" else "neg" end
assert(sign == "neg", "inline conditional expr")

let sum_odds = 0
for n in 1..20 do
    if n == 2 or n == 4 or n == 6 or n == 8 then
        continue
    end
    sum_odds += n
    if n > 9 then
        break
    end
end
assert(sum_odds == 35, "break/continue flow")

# ------------------------------------------------------------
# 6) Functions, defaults, keyword args, lambdas, closures, HOF
# ------------------------------------------------------------
fn greet(name, prefix = "Hi")
    return prefix + ", " + name
end

assert(greet("Ject") == "Hi, Ject", "default param")
assert(greet(name="Ject", prefix="Hello") == "Hello, Ject", "keyword args")

let bias = 7
let add_bias = lambda(v) -> v + bias
assert(add_bias(5) == 12, "lambda closure capture")

let nums = [1, 2, 3, 4, 5, 6]
let evens = filter(nums, lambda(n) -> n > 3)
let doubled = map(evens, lambda(n) -> n * 2)
let total = reduce(doubled, lambda(acc, n) -> acc + n, 0)
assert(total == 30, "map/filter/reduce")
assert(any(nums, lambda(n) -> n > 5) == true, "any")
assert(all([2, 4, 6], lambda(n) -> n > 0) == true, "all")

# ------------------------------------------------------------
# 7) Match, pattern bindings, wildcard, try/catch/throw
# ------------------------------------------------------------
let m1 = match 2
    1 -> "one"
    2 -> "two"
    _ -> "other"
end
assert(m1 == "two", "match literal arm")

let m2 = match 41
    n -> n + 1
end
assert(m2 == 42, "match identifier binding")

let caught = false
try
    throw "boom"
catch err
    caught = true
    assert(err == "boom", "catch thrown value")
end
assert(caught == true, "throw/catch flow")

let caught_runtime = false
try
    let z = 10 / 0
    print z
catch err
    caught_runtime = true
    assert(type_of(err) == "string", "runtime error catch type")
end
assert(caught_runtime == true, "catch runtime error")

# ------------------------------------------------------------
# 8) Strings and interpolation edge-ish checks
# ------------------------------------------------------------
import "string" as strmod

let name = "Neo"
let age = 33
let msg = "User: " + name + ", age: " + to_string(age)
assert(strmod.contains_str(msg, "User: Neo") == true, "string concat baseline")
assert(strmod.contains_str(msg, "age: 33") == true, "string number conversion")

assert(upper("abc") == "ABC", "upper")
assert(lower("ABC") == "abc", "lower")
assert(trim("  x  ") == "x", "trim")
assert(replace("a-b-c", "-", "_") == "a_b_c", "replace")
assert(strmod.starts_with("hello", "he") == true, "starts_with")
assert(strmod.ends_with("hello", "lo") == true, "ends_with")

# ------------------------------------------------------------
# 9) Modules and builtin constants
# ------------------------------------------------------------
import {PHI} from "math"
assert(PHI > 1.6 and PHI < 1.7, "module selective import")
assert(strmod.reverse_str("abc") == "cba", "module alias call")
assert(PI > 3.14 and E > 2.71, "corlib constants")

import "base"
assert(to_hex(255) == "ff", "base to_hex")
assert(from_hex("ff") == 255, "base from_hex")

# ------------------------------------------------------------
# 10) File/system helpers
# ------------------------------------------------------------
let p = "/tmp/ject_megatest.txt"
write_file(p, "line1\nline2")
append_file(p, "\nline3")
assert(file_exists(p) == true, "file_exists")
let lines = read_lines(p)
assert(len(lines) == 3, "read_lines length")

# ------------------------------------------------------------
# 11) GUI module smoke (non-blocking builder path)
# ------------------------------------------------------------
import {button, input, label, run, separator, window} from "gui"
let app = window("MegaTest GUI Builder", 420, 280)
label(app, "GUI builder initialized")
separator(app)
input(app, "field1", "Field 1:", "")
button(app, "ok", "OK")
run(app)

print "=== Ject Mega Test: PASS ==="
